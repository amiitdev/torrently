<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: dark background + transparent glyph logo.
     Avoids the default white circular tile by never using the launcher icon. -->
<resources>
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/torrently_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">320</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/torrently_background</item>
        <item name="android:navigationBarColor">@color/torrently_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
